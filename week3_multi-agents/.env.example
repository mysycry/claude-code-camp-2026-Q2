# Copy to .env and fill in. All values are optional; they override
# agents/squad.yaml and .boukensha/settings.yaml at runtime.

# --- MUD connection (overrides squad.yaml mud: and settings.yaml mud:) ---
MUD_HOST=localhost
MUD_PORT=4000
MUD_USERNAME=dummy
MUD_PASSWORD=helloworld

# --- Squad run overrides ---
SQUAD_TASK=Check the MUD and observability stack, then report what you find.
# SQUAD_MODEL=deepseek-v4-flash-free
# SQUAD_PROVIDER=opencode
# SQUAD_MAX_ITERATIONS=60
# SQUAD_MAX_TURN_TOKENS=60000
# SQUAD_MEMORY_PATH=../memory/memory_bench.db
# SQUAD_TRACE_DIR=traces

# --- Reset (overrides .boukensha/settings.yaml reset:) ---
# RESET_START_ROOM=3001
# RESET_START_ROOM_NAME=The Temple Of Midgaard
# RESET_MAX_ATTEMPTS=3

# --- Observability ---
# BOUKENSHA_OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# --- Mission Control (agent operations panel, overrides squad.yaml mission_control:) ---
# MC_ENABLED=true
# MC_URL=http://localhost:3001
# MC_API_KEY=<api key from Mission Control Settings>
# MC_HEARTBEAT_INTERVAL=30
# BOUKENSHA_VERSION=<optional git sha / version shown in the panel>
