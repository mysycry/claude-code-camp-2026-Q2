{
  "title": "Boukensha Trace Explorer",
  "uid": "boukensha-traces",
  "tags": [
    "boukensha",
    "traces"
  ],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Traces",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "jaeger",
        "uid": "jaeger"
      },
      "options": {
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "count"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "jaeger",
            "uid": "jaeger"
          },
          "queryType": "search",
          "service": "boukensha",
          "tags": "",
          "limit": 100
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#3b82f6"
          },
          "unit": "none"
        }
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Recent Traces",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "jaeger",
        "uid": "jaeger"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "jaeger",
            "uid": "jaeger"
          },
          "queryType": "search",
          "service": "boukensha",
          "tags": "",
          "limit": 50
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Traces Over Time",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "jaeger",
        "uid": "jaeger"
      },
      "options": {
        "legend": {
          "calcs": [
            "count"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "jaeger",
            "uid": "jaeger"
          },
          "queryType": "search",
          "service": "boukensha",
          "tags": "",
          "limit": 100
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#3b82f6"
          }
        }
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Service Operations",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "jaeger",
        "uid": "jaeger"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "jaeger",
            "uid": "jaeger"
          },
          "queryType": "search",
          "service": "boukensha",
          "tags": "",
          "limit": 100
        }
      ],
      "transformations": [
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "traceName": {
                "aggregations": [
                  "count"
                ],
                "operation": "aggregateBy"
              },
              "duration": {
                "aggregations": [
                  "min",
                  "max",
                  "mean"
                ],
                "operation": "aggregateBy"
              }
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        }
      }
    }
  ]
}