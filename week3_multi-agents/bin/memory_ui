#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
VENV="$ROOT/.venv"
PYTHON="$VENV/Scripts/python"
if [ -f "${PYTHON}.exe" ]; then
  PYTHON="${PYTHON}.exe"
fi

export BOUKENSHA_DIR="$ROOT/.boukensha"
export MUD_MANAGER_DIR="$ROOT/.mud_manager"

SERVER_SCRIPT="$ROOT/week3_multi-agents/memory/memory_server.py"

echo "Starting Boukensha Memory UI..."
echo "  DB: $ROOT/week3_multi-agents/memory/memory_bench.db"
echo "  Server: http://localhost:9876"
echo "  Grafana dashboard: http://localhost:3000 (add Memory API datasource)"
echo ""

exec "$PYTHON" "$SERVER_SCRIPT"
